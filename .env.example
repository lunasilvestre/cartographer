# eo-mcp configuration — every value is optional.
# The defaults point at the public demo backend, so an empty file works fine.
# Copy to .env and edit to target your own eoAPI deployment.
#
# The three URL settings are validated at startup. A trailing slash is
# normalised away; http:// is accepted for local backends; a missing scheme,
# an empty value, or a query string is rejected with a message naming the
# variable. See docs/SELF-HOSTING.md.

# --- Backends ---------------------------------------------------------------

# TiTiler (raster) base URL
EO_MCP_RASTER_URL=https://api.cheias.pt/raster

# tipg (OGC API Features) base URL
EO_MCP_VECTOR_URL=https://api.cheias.pt/vector

# STAC API base URL
EO_MCP_STAC_URL=https://api.cheias.pt

# Bearer token, if your backend requires authentication. Leave empty for none.
EO_MCP_AUTH_TOKEN=

# --- HTTP behaviour ---------------------------------------------------------

# Seconds allowed to establish a connection. Short on purpose: a backend that
# is not answering its socket will not start answering in 30 seconds.
EO_MCP_CONNECT_TIMEOUT=5.0

# Seconds allowed for the backend to produce a response body. Generous:
# zonal statistics over a large polygon is genuinely slow work.
EO_MCP_REQUEST_TIMEOUT=30.0

# Retries *after* the first attempt, so the default is three attempts total.
# Set to 0 to disable retries.
EO_MCP_MAX_RETRIES=2

# Base for exponential backoff between retries, in seconds. 0 retries instantly.
EO_MCP_RETRY_BACKOFF=0.5

# Maximum in-flight requests per backend. Bounds the fan-out of the workflow
# tools so a retry storm cannot become a thundering herd.
EO_MCP_MAX_CONCURRENCY=5

# --- Testing ----------------------------------------------------------------

# Set to 1 to skip the live integration tests. `pytest -m "not slow"` also
# works. CI sets this; a backend outage must never turn the build red.
# EO_MCP_SKIP_INTEGRATION=1
